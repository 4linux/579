{
  "uid": "bb-otel-metrics",
  "title": "BB - OpenTelemetry Demo | Metricas",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "15s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "panels": [
    {
      "type": "timeseries",
      "title": "Series de metricas da Demo por servico (indicador diagnostico)",
      "gridPos": {
        "h": 12,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "count by (service_name) ({service_name!=\"\"})",
          "legendFormat": "{{service_name}}",
          "refId": "A"
        }
      ]
    }
  ]
}